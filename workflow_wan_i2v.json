{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "wan2.1-i2v-14b-480p-Q4_K_S.gguf"
    },
    "_meta": { "title": "Load Wan2.1 I2V GGUF" }
  },

  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_image.png"
    },
    "_meta": { "title": "Load Input Image" }
  },

  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    },
    "_meta": { "title": "Load T5 Text Encoder" }
  },

  "4": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    },
    "_meta": { "title": "Load CLIP Vision" }
  },

  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "anime woman, smooth natural movement, gentle breeze, wind in hair, subtle motion",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Positive Prompt" }
  },

  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "low quality, blurry, static image, no motion, watermark, deformed",
      "clip": ["3", 0]
    },
    "_meta": { "title": "Negative Prompt" }
  },

  "7": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "_meta": { "title": "Load VAE" }
  },

  "8": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "model":       ["1", 0],
      "clip_vision": ["4", 0],
      "image":       ["2", 0],
      "vae":         ["7", 0],
      "positive":    ["5", 0],
      "negative":    ["6", 0],
      "width":       832,
      "height":      480,
      "length":      49,
      "batch_size":  1,
      "seed":        42,
      "steps":       20,
      "cfg":         6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler":   "linear",
      "denoise":     1.0
    },
    "_meta": { "title": "Wan Image To Video" }
  },

  "9": {
    "class_type": "VAEDecodeVideo",
    "inputs": {
      "samples": ["8", 0],
      "vae":     ["7", 0]
    },
    "_meta": { "title": "VAE Decode Video" }
  },

  "10": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images":           ["9", 0],
      "frame_rate":       16,
      "loop_count":       0,
      "filename_prefix":  "wan_output",
      "format":           "video/mp4",
      "pingpong":         false,
      "save_output":      true
    },
    "_meta": { "title": "Save MP4" }
  }
}
